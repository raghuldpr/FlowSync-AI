# Copy to .env. Never commit real keys. The core demo works with none of the LLM values set.
FLOWSYNC_OPERATOR_PASSWORD=change-me
FLOWSYNC_DB_PATH=flowsync.db
FLOWSYNC_DEVICES_PATH=config/devices.yaml

# LLM (Phase 5): any OpenAI-compatible endpoint
LLM_ENABLED=false
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
